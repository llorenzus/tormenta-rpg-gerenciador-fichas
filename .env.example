# Arquivo de exemplo para variáveis de ambiente (Firebase e App)
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Firebase Console:
# Firebase Console -> Configurações do Projeto (ícone de engrenagem) -> Geral -> Seus aplicativos -> Web (</>)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
