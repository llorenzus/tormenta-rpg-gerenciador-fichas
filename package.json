{
  "name": "trpg-gerenciador-fichas",
  "version": "1.3.1",
  "description": "Aplicativo para gerenciamento de fichas de personagem do sistema Tormenta RPG (TRPG)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llorenzus/tormenta-rpg-gerenciador-fichas.git"
  },
  "homepage": "https://github.com/llorenzus/tormenta-rpg-gerenciador-fichas#readme",
  "bugs": {
    "url": "https://github.com/llorenzus/tormenta-rpg-gerenciador-fichas/issues"
  },
  "main": "index.ts",
  "scripts": {
    "start": "node -r ./polyfill-node.js node_modules/expo/bin/cli start",
    "android": "node -r ./polyfill-node.js node_modules/expo/bin/cli start --android",
    "ios": "node -r ./polyfill-node.js node_modules/expo/bin/cli start --ios",
    "web": "node -r ./polyfill-node.js node_modules/expo/bin/cli start --web",
    "export:web": "node -r ./polyfill-node.js node_modules/expo/bin/cli export -p web",
    "electron": "node electron/run.js",
    "test": "tsx --import ./polyfill-node.js --test tests/layout_consistencia_plataformas.test.ts tests/regras_calculos_ficha.test.ts tests/regras_compendio_conversao.test.ts tests/regras_prerequisitos_talentos.test.ts tests/updateChecker.test.ts tests/firebaseConfig.test.ts tests/authService.test.ts tests/syncService.test.ts tests/sharingService.test.ts",
    "build:windows": "node -r ./polyfill-node.js node_modules/expo/bin/cli export -p web && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.25",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-print": "~58.0.9",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "firebase": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.tormenta.gerenciadorfichas",
    "productName": "TRPG Gerenciador de Fichas",
    "publish": null,
    "directories": {
      "output": "dist-electron"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-v${version}.${ext}"
    }
  },
  "private": true
}
